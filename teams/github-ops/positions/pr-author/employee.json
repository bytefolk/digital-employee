{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "pr-author",
  "version": "0.1.0",
  "description": "按 issue 实现改动、推分支并开 PR，按评审意见修改到通过；不批准、不合并任何 PR。",
  "license": "Apache-2.0",
  "authors": [
    "bytefolk"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "approval_required",
    "network": "host_policy",
    "filesystem": {
      "read": [
        "./knowledge/**",
        "./context/**"
      ],
      "write": [
        "./context/**"
      ]
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./evals/cases.json",
    "./permissions.json"
  ]
}
