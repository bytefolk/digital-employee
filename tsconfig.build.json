{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "apps/**/*.ts",
    "connectors/**/*.ts",
    "packages/**/*.ts",
    "profiles/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["tests"]
}
