{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fullstack-ai-infra/digital-employee/blob/main/configs/schema.json",
  "title": "Digital Employee configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "employee",
    "model",
    "sources"
  ],
  "properties": {
    "employee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                }
              }
            }
          ]
        },
        "domain": {
          "type": "string",
          "maxLength": 512
        },
        "instructions": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": {
          "const": true
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "minScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sessionTtlMs": {
          "type": "integer",
          "minimum": 1000
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1
        },
        "maxMessages": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "const": "extractive"
            },
            "prefix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "baseUrl",
            "apiKeyEnv",
            "model"
          ],
          "properties": {
            "provider": {
              "const": "openai-compatible"
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            },
            "apiKeyEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "allowPrivateNetwork": {
              "type": "boolean"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 10000000
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$",
              "not": {
                "enum": [
                  "extractive",
                  "openai-compatible"
                ]
              }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "channel": {
      "type": "object"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiTokenEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minEvidence": {
          "type": "integer",
          "minimum": 0
        },
        "minCitations": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "string",
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
