{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "answer",
    "citations"
  ],
  "properties": {
    "status": {
      "enum": [
        "answered",
        "escalated"
      ]
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
