{
  "all": false,
  "src": ["apps", "connectors", "packages", "profiles", "scripts"],
  "include": [
    "apps/**/*.ts",
    "connectors/**/*.ts",
    "packages/**/*.ts",
    "profiles/**/*.ts",
    "scripts/**/*.js",
    "dist/apps/**/*.js",
    "dist/connectors/**/*.js",
    "dist/packages/**/*.js",
    "dist/profiles/**/*.js"
  ],
  "exclude": ["tests/**", "node_modules/**", "coverage/**"],
  "excludeAfterRemap": false,
  "reporter": ["text-summary"],
  "skip-full": false
}
