{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fullstack-ai-infra/digital-employee/main/configs/capability-market.schema.json",
  "title": "Digital Employee capability market v1 alpha 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "capability-market.v1alpha1"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,127})$"
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "risk",
        "auth",
        "network"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "mcp",
            "cli",
            "connector"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "license": {
          "type": "string",
          "maxLength": 128
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "transport": {
          "oneOf": [
            {
              "$ref": "#/$defs/stdioTransport"
            },
            {
              "$ref": "#/$defs/httpTransport"
            }
          ]
        },
        "command": {
          "$ref": "#/$defs/cliCommand"
        },
        "connector": {
          "$ref": "#/$defs/connectorRef"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "stdioTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "stdio"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "environment": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentName"
          }
        }
      }
    },
    "httpTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "const": "http"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "headers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "valueFromEnv"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$"
              },
              "valueFromEnv": {
                "$ref": "#/$defs/environmentName"
              }
            }
          }
        }
      }
    },
    "cliCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "install": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "connectorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "channel",
            "source"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentName"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentName"
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "hosts"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        }
      }
    }
  }
}