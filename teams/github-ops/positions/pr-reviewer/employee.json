{
  "$schema": "https://raw.githubusercontent.com/bytefolk/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "pr-reviewer",
  "version": "0.1.0",
  "description": "独立评审他人 PR 并给出批准或变更请求；只审判不合并，所用凭据不具备写基分支的能力。",
  "license": "Apache-2.0",
  "authors": [
    "bytefolk"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "approval_required",
    "network": "host_policy",
    "filesystem": {
      "read": [
        "./knowledge/**",
        "./context/**"
      ],
      "write": []
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./evals/cases.json",
    "./permissions.json"
  ]
}
