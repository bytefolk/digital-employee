{
  "employee": {
    "id": "team-answer",
    "displayName": "Team Answer",
    "profile": "answer-agent"
  },
  "runtime": {
    "readOnly": true,
    "topK": 6,
    "minScore": 0.1
  },
  "channel": {
    "type": "dingtalk",
    "clientIdEnv": "DINGTALK_CLIENT_ID",
    "clientSecretEnv": "DINGTALK_CLIENT_SECRET"
  },
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "model": "gpt-4.1-mini"
  },
  "sources": [
    {
      "id": "approved-local-docs",
      "type": "filesystem",
      "root": "../tests/fixtures/knowledge",
      "include": [
        ".md"
      ]
    },
    {
      "id": "approved-dingtalk-knowledge",
      "type": "dws",
      "profile": "corp-id:user-id",
      "approvedQueries": [
        {
          "name": "product-handbook",
          "command": [
            "doc",
            "read"
          ],
          "args": [
            "--node",
            "approved-node-id"
          ]
        }
      ]
    }
  ],
  "escalation": {
    "threshold": 0.3,
    "message": "I do not have enough approved evidence. A maintainer should review this question."
  }
}
